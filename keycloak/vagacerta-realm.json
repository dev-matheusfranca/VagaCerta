{
  "realm": "vagacerta",
  "displayName": "VagaCerta",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginTheme": "vagacerta",
  "internationalizationEnabled": true,
  "supportedLocales": ["pt-BR"],
  "defaultLocale": "pt-BR",
  "roles": {
    "realm": [
      { "name": "owner", "description": "Dono ou equipe de um estabelecimento" },
      { "name": "admin", "description": "Administra o catálogo da plataforma" },
      { "name": "booking-holds", "description": "Serviços que reservam e confirmam horários" }
    ]
  },
  "groups": [
    { "name": "6384a99a-146a-4b11-8e9b-db99b79e8fd2", "attributes": { "estabelecimento": ["Barbearia Navalha de Ouro"] } },
    { "name": "82e6f4b6-a076-4690-85f3-ca4b4bc17c49", "attributes": { "estabelecimento": ["Studio Bella Unhas"] } },
